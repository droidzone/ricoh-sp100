%!PS
% Three-page A4 test document for "make check" and test prints:
% a title, 30 lines of 12 pt text, a 10-step gray ramp and a frame that
% marks the printable area (12 pt from each edge).
/Helvetica findfont 12 scalefont setfont
1 1 3 { /n exch def
  0.5 setlinewidth 12 12 571 818 rectstroke
  /Helvetica-Bold findfont 24 scalefont setfont
  72 760 moveto (Ricoh DDST filter test page ) show n 3 string cvs show
  /Helvetica findfont 12 scalefont setfont
  0 1 29 { /i exch def
    72 720 i 18 mul sub moveto
    (The quick brown fox jumps over the lazy dog 0123456789) show } for
  0 1 9 { /i exch def i 10 div setgray 72 i 45 mul add 72 40 72 rectfill } for
  0 setgray
  showpage } for
